url <- paste0(
"https://www.norman-network.com/nds/api/empodat/inchikey/",
URLencode(inchikey, reserved = TRUE),
"/JSON"
)
request(url) %>%
req_perform() %>%
resp_body_json(simplifyVector = TRUE)
}
