filenameRDS <- paste("RDS/", deparse(substitute(df)),".RDS")
saveRDS(df.comb, filenameRDS)
filenameCSV <- paste("CSV/", deparse(substitute(df)),".csv")
write.csv(df.comb, filenameCSV,
fileEncoding="Windows-1252", row.names = FALSE)
}
