# write function to get data by inchikey
get_empodat <- function(inchikey) {
purrr::map(
inchikey,
\(key) {
request(
paste0(
"https://www.norman-network.com/nds/api/empodat/inchikey/",
URLencode(key, reserved = TRUE),
"/JSON"
)
) %>%
req_perform() %>%
resp_body_json(simplifyVector = TRUE)
}
)
}
