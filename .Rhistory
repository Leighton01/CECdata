# Optional: specify date ranges or parameters if needed
FraDato = "2000-01-01",
TilDato = format(Sys.Date(), "%Y-%m-%d")
)) %>%
req_perform() %>%
resp_body_string() %>%
fromJSON(flatten = TRUE)
}
# Fetch results
chemical_data <- fetch_vannmiljo_data(van.ids)
fetch_vannmiljo <- function(id) {
url <- sprintf(
"https://vannmiljofaktaark.miljodirektoratet.no/Home/ExportToExcel/%s",
id
)
tmp <- tempfile(fileext = ".xlsx")
resp <- tryCatch(
request(url) |>
req_headers(
"User-Agent" = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) R-httr2"
) |>
req_retry(max_tries = 3, backoff = ~2) |>
req_perform(path = tmp),
error = function(e) NULL
)
if (is.null(resp) || resp_status(resp) != 200) {
warning(sprintf("Failed for id %s (status %s)", id,
if (!is.null(resp)) resp_status(resp) else "NA"))
return(NULL)
}
out <- tryCatch(read_excel(tmp), error = function(e) NULL)
if (!is.null(out)) out$vannmiljo_id <- id
out
}
# throttle to avoid tripping rate limits / bot detection
results <- map(van.ids, function(id) {
Sys.sleep(0.5)
fetch_vannmiljo(id)
})
vannmiljo_data <- bind_rows(results)
vannmiljo_data
fetch_vannmiljo_batch <- function(ids) {
# Build strict payload required by Vannmiljø export service
payload <- list(
WaterLocationIDFilter = as.list(ids),
MediumID = "Vann",
RegType = 1, # 1 for chemical/physical measurements
FromDateSamplingTime = "2000-01-01",
ToDateSamplingTime = format(Sys.Date(), "%Y-%m-%d"),
ExportType = "redigering"
)
resp <- request(url) %>%
req_headers(`Content-Type` = "application/json") %>%
req_body_json(payload) %>%
# Prevent failure on non-200 responses to debug errors cleanly
req_error(is_error = \(resp) FALSE) %>%
req_perform()
# Check response status
if (resp_status(resp) != 200) {
warning(paste("Batch failed with status:", resp_status(resp)))
return(NULL)
}
# Parse body
body_text <- resp_body_string(resp)
if (nchar(body_text) == 0) return(NULL)
fromJSON(body_text, flatten = TRUE)
}
# Process in small batches (e.g., 20 IDs at a time) to avoid HTTP 500 server timeouts
batch_size <- 20
id_chunks <- split(van.ids, ceiling(seq_along(van.ids) / batch_size))
results <- map(id_chunks, fetch_vannmiljo_batch) %>%
compact() %>%
bind_rows()
id_chunks
results <- map(id_chunks, fetch_vannmiljo_batch) %>%
compact() %>%
bind_rows()
